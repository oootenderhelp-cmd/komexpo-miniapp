# Komexpo Work — environment variables
# Copy to .env and fill in real values

# MySQL connection (MUST include ?charset=utf8mb4 for Cyrillic)
DATABASE_URL=mysql://user:password@localhost:3306/komexpo_work?charset=utf8mb4

# JWT secret for auth tokens (generate random 64+ char string)
JWT_SECRET=change-me-to-random-secret

# App ID
VITE_APP_ID=komexpo-work
VITE_APP_TITLE=Komexpo Work

# Owner user (first admin account openId)
OWNER_OPEN_ID=owner-admin

# Optional: LLM API (leave empty if not using AI features)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Optional: analytics
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
