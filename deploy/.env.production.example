# ─────────────────────────────────────────────────────────────
# Tendrovik AI — production environment (Beget VPS / comx.ru)
# Copy to deploy/.env and fill all values marked REQUIRED
# ─────────────────────────────────────────────────────────────

# REQUIRED: PostgreSQL password (min 20 chars, generated)
POSTGRES_PASSWORD=

# REQUIRED: JWT signing secret (min 32 chars)
# Generate: openssl rand -base64 48
JWT_SECRET=

# Business rules
DEFAULT_MIN_MARGIN_PCT=12
