# ─────────────────────────────────────────────────────────────
# Тендровик AI — backend foundation
# Copy to `.env` and fill values. NO real secrets are committed.
# All external integrations below are STUBS until real keys are set.
# ─────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=

# PostgreSQL (Drizzle)
DATABASE_URL=

# --- AI provider (stub) ---
# When empty, StubAIProvider returns deterministic canned responses.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# --- CRM: Bitrix24 (stub) ---
BITRIX24_WEBHOOK_URL=
BITRIX24_CLIENT_ID=
BITRIX24_CLIENT_SECRET=

# --- Email / notifications (stub) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_FROM_EMAIL=

# --- Payments (stub, no real charges) ---
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# --- Procurement platforms (stub adapters only) ---
# Real площадки are NOT connected in the foundation module.
ZAKUPKI_API_BASE=
SBERAST_API_BASE=

# --- Background queue ---
QUEUE_CONCURRENCY=

# --- Business rules ---
DEFAULT_MIN_MARGIN_PCT=12
